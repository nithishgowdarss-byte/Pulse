# Copy to .env (never commit .env). All keys are optional; free tiers only.

# Server
HOST=127.0.0.1            # use 0.0.0.0 only inside a container / behind a reverse proxy
PORT=3000
NODE_ENV=development
DATA_DIR=./.data          # durable JSON snapshot location (/data in Docker)
# PERSISTENCE=off         # disable durable storage (tests/demo)
# TRUST_PROXY=1           # set when behind a reverse proxy so rate limits see real IPs
# ENABLE_HSTS=1           # only when served over HTTPS
SESSION_SECRET=            # required in production, >= 32 chars (openssl rand -hex 32)
SUPER_OWNER_PIN=           # production bootstrap PIN for the super owner
SECRETS_KEY=               # required in production: 32-byte key, hex (openssl rand -hex 32); encrypts stored MSG91 keys
# WHATSAPP_WEBHOOK_SECRET=
# PULSE_BASIC_AUTH=owner:change-me   # perimeter login for the whole app (strongly recommended in production)
# PULSE_ALLOW_DEV_ENDPOINTS=1   # re-enable /api/reset-seed and hard delete in production (not recommended)
# API_RATE_LIMIT_PER_MIN=600
# AI_RATE_LIMIT_PER_MIN=20

# AI (cascade: Gemini -> local FreeLLMAPI gateway -> other free providers -> built-in offline engine)
GEMINI_API_KEY=           # free key from https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.5-flash
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
# FREELLMAPI_MODEL=auto
# FREELLMAPI_ENABLED=0
# FREELLMAPI_TIMEOUT_MS=30000
